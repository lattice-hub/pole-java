<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>io.github.lattice-hub</groupId><artifactId>spring-cloud-plugins</artifactId><version>0.1.0-SNAPSHOT</version></parent>
    <artifactId>spring-cloud-plugin</artifactId>
    <name>Pole Agent Spring Cloud Entry Plugin</name>
    <description>Spring Cloud discovery, version selection, and adapter installation</description>
    <dependencies>
        <dependency><groupId>${project.groupId}</groupId><artifactId>pole-agent-api</artifactId></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>pole-agent-bootstrap</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>net.bytebuddy</groupId><artifactId>byte-buddy</artifactId><version>${byte-buddy.version}</version></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>pole-spring-cloud-common</artifactId></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <exclude>${project.groupId}:pole-agent-api</exclude>
                                    <exclude>${project.groupId}:pole-agent-bootstrap</exclude>
                                </excludes>
                            </artifactSet>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation><pattern>io.github.latticehub.client</pattern><shadedPattern>io.github.latticehub.agent.plugin.springcloud.payload.client</shadedPattern></relocation>
                                <relocation><pattern>io.github.latticehub.pole.specification</pattern><shadedPattern>io.github.latticehub.agent.plugin.springcloud.payload.specification</shadedPattern></relocation>
                                <relocation><pattern>io.grpc</pattern><shadedPattern>io.github.latticehub.agent.plugin.springcloud.payload.grpc</shadedPattern></relocation>
                                <relocation><pattern>com.google</pattern><shadedPattern>io.github.latticehub.agent.plugin.springcloud.payload.google</shadedPattern></relocation>
                                <relocation><pattern>io.perfmark</pattern><shadedPattern>io.github.latticehub.agent.plugin.springcloud.payload.perfmark</shadedPattern></relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/spring.factories</exclude>
                                        <exclude>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
