<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>io.github.lattice-hub</groupId><artifactId>thrift-plugins</artifactId><version>0.1.0-SNAPSHOT</version></parent>
    <artifactId>thrift-http-plugin</artifactId>
    <name>Pole Agent Thrift HTTP Plugin</name>
    <description>Apache Thrift THttpClient and TServlet TrafficContext instrumentation</description>
    <dependencies>
        <dependency><groupId>${project.groupId}</groupId><artifactId>pole-agent-api</artifactId></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>pole-agent-bootstrap</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>pole-thrift-http</artifactId></dependency>
        <dependency><groupId>net.bytebuddy</groupId><artifactId>byte-buddy</artifactId><version>${byte-buddy.version}</version></dependency>
    </dependencies>
    <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
            <artifactSet><includes>
                <include>${project.groupId}:pole-thrift-http</include>
                <include>${project.groupId}:pole-client-java</include>
                <include>net.bytebuddy:byte-buddy</include>
            </includes></artifactSet>
            <createDependencyReducedPom>false</createDependencyReducedPom>
            <filters><filter><artifact>*:*</artifact><excludes>
                <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
            </excludes></filter></filters>
            <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/></transformers>
        </configuration></execution></executions>
    </plugin></plugins></build>
</project>
