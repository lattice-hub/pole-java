<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.lattice-hub</groupId>
        <artifactId>pole-java-agent-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pole-java-agent</artifactId>
    <name>Pole Java Agent</name>
    <description>Thin bootstrap JAR and directory distribution for Pole Java Agent</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>pole-agent-bootstrap</artifactId>
        </dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>pole-agent-api</artifactId><optional>true</optional></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>pole-agent-core</artifactId><optional>true</optional></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>spring-cloud-plugin</artifactId><optional>true</optional></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>spring-cloud-3x-plugin</artifactId><optional>true</optional></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>spring-cloud-4x-plugin</artifactId><optional>true</optional></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>spring-cloud-5x-plugin</artifactId><optional>true</optional></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>dubbo-3x-plugin</artifactId><optional>true</optional></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>grpc-1x-plugin</artifactId><optional>true</optional></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>thrift-http-plugin</artifactId><optional>true</optional></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>${project.groupId}:pole-agent-bootstrap</include>
                                </includes>
                            </artifactSet>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>io.github.latticehub.agent.PoleJavaAgent</Premain-Class>
                                        <Can-Redefine-Classes>false</Can-Redefine-Classes>
                                        <Can-Retransform-Classes>false</Can-Retransform-Classes>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>agent-distribution</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/distribution.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
